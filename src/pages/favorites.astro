---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="收藏 · 禾愿辞屿"><section class="favorites narrow"><p class="eyebrow">Favorites</p><h1>留住美好</h1><p class="muted">免登录、快捷收藏您喜欢的内容，数据只保存在当前浏览器，不会分享至其他地方。</p><div id="favorites-list"></div><button id="clear" hidden>清空全部</button></section></BaseLayout>
<script>
  const root=document.querySelector<HTMLElement>('#favorites-list');
  const clear=document.querySelector<HTMLButtonElement>('#clear');
  const key='fourfold-favorites';
  const render=()=>{
    let ids: string[]=[];
    try { const value=JSON.parse(localStorage.getItem(key)||'[]'); if(Array.isArray(value)) ids=value.filter((id): id is string => typeof id === 'string' && id.startsWith('/')); } catch {}
    if(root) {
      root.replaceChildren();
      if(ids.length) {
        ids.forEach((id)=>{ const paragraph=document.createElement('p'); paragraph.className='saved'; const link=document.createElement('a'); link.href=id; link.textContent=id; paragraph.append(link); root.append(paragraph); });
      } else {
        const empty=document.createElement('p'); empty.className='empty'; empty.textContent='( •̀ ω •́ )✧收藏夹还什么都没有哦~ 不如打开一篇内容，点击收藏留住美好吧！'; root.append(empty);
      }
    }
    clear?.toggleAttribute('hidden',!ids.length);
  };
  clear?.addEventListener('click',()=>{try { localStorage.removeItem(key); } catch {} render()});
  render();
</script>
<style>.favorites{padding:5rem 0}.favorites h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.empty{border-block:1px solid var(--line);padding:2rem 0;color:var(--muted)}.saved{border-bottom:1px solid var(--line);padding:1rem 0}.saved a{color:var(--accent)}button{border:1px solid var(--line);background:none;padding:.5rem .8rem;cursor:pointer}</style>
