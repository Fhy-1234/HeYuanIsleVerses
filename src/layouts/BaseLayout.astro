---
import SEO from '../components/SEO.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import '../styles/global.css';
const { title, description, image, canonical, type, structuredData } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <SEO title={title} description={description} image={image} canonical={canonical} type={type} structuredData={structuredData} />
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('fourfold-theme') || 'system'; } catch { document.documentElement.dataset.theme = 'system'; }</script>
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
  </body>
</html>
